<Window x:Class="EntityAnalyzer.App.Views.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Палитра команд" Width="520" Height="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushBgMain}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="QueryBox" FontSize="16" Padding="8,6"
                 TextChanged="QueryBox_TextChanged"
                 KeyDown="QueryBox_KeyDown"
                 ToolTip="Введите часть названия команды (Ctrl+K)"/>

        <ListBox Grid.Row="1" x:Name="ResultList" Margin="0,12,0,0"
                 MouseLeftButtonDown="ResultList_Click"
                 KeyDown="QueryBox_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding Title}" FontSize="14"/>
                        <TextBlock Text="{Binding Hint}" Style="{DynamicResource MetaStyle}" Margin="12,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Style="{DynamicResource MetaStyle}" Margin="0,10,0,0"
                   Text="↑↓ — выбор · Enter — выполнить · Esc — закрыть"/>
    </Grid>
</Window>

<Window x:Class="EntityAnalyzer.App.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал изменений каталога" Width="760" Height="560"
        Background="{DynamicResource BrushBgMain}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="ИСТОРИЯ ИЗМЕНЕНИЙ КАТАЛОГА СУЩНОСТЕЙ"
                   Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,16"/>
        <ListBox x:Name="List" Grid.Row="1"
                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Только текст: время / действие / сущность / детали -->
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding Ts, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}"
                             Foreground="{DynamicResource BrushTextDisabled}"/>
                        <Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Run Text="{Binding Entity, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Run Text="{Binding Details, Mode=OneWay}"
                             Foreground="{DynamicResource BrushTextSecondary}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>

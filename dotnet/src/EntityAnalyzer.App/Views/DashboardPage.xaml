<UserControl x:Class="EntityAnalyzer.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:EntityAnalyzer.App.Behaviors"
             xmlns:views="clr-namespace:EntityAnalyzer.App.Views">

    <!-- Экран «Обзор»: левая колонка (Bg-Nav, настройки, ширина регулируется
         сплиттером) / правая — вкладки «Обзор» и «Поиск и паттерны». -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="560"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="7*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- Разделитель колонок: тянется, меняя ширину настроек -->
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      Style="{DynamicResource AcademicSplitterStyle}"/>

        <!-- ═══ Левая колонка: настройки (Bg-Nav) ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource BrushBgNav}"
                BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,32,32,48">

                    <TextBlock Text="ПАРАМЕТРЫ АНАЛИЗА"
                               Style="{DynamicResource SectionHeaderStyle}"/>

                    <!-- Корпус. QA-UX #5: подпись честно перечисляет форматы -->
                    <TextBlock Text="Папка с текстами (.txt, .fb2, .epub, .docx…)"
                               Style="{DynamicResource MetaStyle}" Margin="0,24,0,0"/>
                    <TextBox Text="{Binding CorpusDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                    <Button Content="Выбрать папку…" Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding BrowseCorpus}" HorizontalAlignment="Left" Padding="0,8"/>
                    <!-- R2-11: исследование как файл — сохранить/открыть контекст целиком -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="💾 Сохранить исследование…" Style="{DynamicResource GhostButtonStyle}"
                                Command="{Binding SaveProjectCommand}" Padding="0,8"
                                ToolTip="Упаковать корпус, кодекс, паттерны и настройки в один файл .eaproj — перенос на другую машину одним файлом"/>
                        <Button Content="📂 Открыть исследование…" Style="{DynamicResource GhostButtonStyle}"
                                Command="{Binding OpenProjectCommand}" Padding="0,8" Margin="16,0,0,0"
                                ToolTip="Открыть .eaproj: восстановить кодекс, паттерны, корпус и профиль"/>
                    </StackPanel>

                    <!-- UX: продолжить вчерашнее исследование без поиска файла в проводнике. -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="НЕДАВНИЕ ИССЛЕДОВАНИЯ"
                                   Style="{DynamicResource SectionHeaderStyle}"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ItemsControl ItemsSource="{Binding RecentProjects}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="✕"
                                                Style="{DynamicResource MiniGhostButtonStyle}"
                                                Command="{Binding DataContext.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Path}"
                                                AutomationProperties.Name="Убрать из недавних"
                                                ToolTip="Убрать из списка недавних"/>
                                        <Button Content="{Binding FileName}"
                                                Style="{DynamicResource GhostButtonStyle}"
                                                HorizontalContentAlignment="Left"
                                                Padding="0,4"
                                                Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Path}"
                                                ToolTip="{Binding ToolTip}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- R2-6: watch-режим — анализ перезапускается сам при правках корпуса -->
                    <Button Content="{Binding WatchButtonText}" Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding WatchCommand}" HorizontalAlignment="Left" Padding="0,8" Margin="0,8,0,0"
                            ToolTip="Следить за папкой корпуса: сохранение текста в редакторе автоматически перезапускает анализ"/>
                    <!-- QA-UX #5: сводка форматов видна без раскрытия раздела -->
                    <TextBlock Style="{DynamicResource MetaStyle}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource BrushTextSecondary}">
                        <Run Text="Будет прочитано: "/><Run Text="{Binding EnabledFormatsCount, Mode=OneWay}"/><Run Text=" форматов — полный список в разделе «Форматы файлов» ниже"/>
                    </TextBlock>

                    <!-- Профиль -->
                    <TextBlock Text="Профиль поиска"
                               Style="{DynamicResource MetaStyle}" Margin="0,16,0,0"/>
                    <!-- QA-UX #1: русские названия профилей; SelectedValue хранит id -->
                    <ComboBox ItemsSource="{Binding PresetItems}"
                              DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding Preset}" MinWidth="280" Margin="0,8,0,0"/>
                    <!-- UX: человекочитаемая сводка профиля вместо эпитета-загадки -->
                    <TextBlock Text="{Binding PresetSummary, Mode=OneWay}" Style="{DynamicResource MetaStyle}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <!-- UX: что именно будет искаться — прямо над кнопкой запуска -->
                    <TextBlock Text="{Binding CodexSummary, Mode=OneWay}" Style="{DynamicResource MetaStyle}"
                               TextWrapping="Wrap" Margin="0,16,0,0"
                               ToolTip="Справочник сущностей, по которым ведётся поиск. Пополнить его можно на странице «Кодекс»."/>

                    <!-- Запуск: прогресс виден только во время анализа (UX: нулевая полоса читалась как «что-то идёт») -->
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                 Maximum="{Binding ProgressMax, Mode=OneWay}" Margin="0,32,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding EtaText}" Style="{DynamicResource TechStyle}" Margin="0,8,0,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

                    <Button Content="Запустить анализ" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding RunCommand}" HorizontalAlignment="Left"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding StartHint}" Margin="0,24,0,0"/>
                    <!-- R2-18: онбординг — демо-цикл одной кнопкой -->
                    <Button Content="▶ Демо-корпус за 30 секунд" Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding RunDemoCommand}" HorizontalAlignment="Left" Padding="0,8"
                            Margin="0,16,0,0"
                            ToolTip="Записывает встроенный микрокорпус (5 текстов) и сразу запускает анализ: полный цикл без выбора папок"/>
                    <Button Content="Отмена" Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding CancelCommand}" HorizontalAlignment="Left" Padding="0,8"/>
                    <TextBlock Text="{Binding StartHint}" Style="{DynamicResource MetaStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StartHint, Converter={StaticResource EmptyToCollapsed}}"/>

                    <!-- Настройки парсинга: свёрнутые секции со стрелкой > -->
                    <Expander Margin="0,48,0,0">
                        <Expander.Header>
                            <TextBlock Text="ПАРАМЕТРЫ ПАРСИНГА" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Контекст, слов" Style="{DynamicResource MetaStyle}"/>
                                    <TextBox Text="{Binding ContextWords, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Цитат на файл (0 = ∞)" Style="{DynamicResource MetaStyle}"/>
                                    <TextBox Text="{Binding MentionsPerFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <CheckBox Content="Нечёткий поиск опечаток" IsChecked="{Binding Fuzzy}" Margin="0,0,0,8"
                                      ToolTip="Находит имена с 1–2 опечатками: Наг → Нагг, Йеб → Еб. Замедляет поиск на больших корпусах."/>
                            <CheckBox Content="Глубокая порча имён" IsChecked="{Binding DeepCorrupt}"
                                      ToolTip="Дополнительно генерирует искажённые формы запретных имён (пропуски и замены букв) — для текстов с намеренно испорченными названиями."/>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,24,0,0">
                        <Expander.Header>
                            <TextBlock Text="ФИЛЬТРЫ ЛОЖНЫХ СРАБАТЫВАНИЙ" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <CheckBox Content="Границы слов" IsChecked="{Binding BoundaryFilters}" Margin="0,0,0,8"
                                      ToolTip="Отсекает совпадения, вклеенные в соседние слова"/>
                            <CheckBox Content="Плотность сущностей" IsChecked="{Binding ListingDensity}" Margin="0,0,0,8"
                                      ToolTip="Контексты, забитые другими именами — оглавления и справочники"/>
                            <CheckBox Content="Чёрный список фраз" IsChecked="{Binding BlacklistPhrases}" Margin="0,0,0,8"
                                      ToolTip="Известные заголовки списков («Великие ужасы и тайны…» и т.п.)"/>
                            <CheckBox Content="Осмысленность" IsChecked="{Binding Meaningfulness}" Margin="0,0,0,8"
                                      ToolTip="Контекст без служебных слов = перечисление имён, не проза"/>
                            <CheckBox Content="Общие слова" IsChecked="{Binding CommonWordRule}" Margin="0,0,0,8"
                                      ToolTip="Сущности вроде «Сон»/«Кот» только при мифологическом окружении"/>
                            <CheckBox Content="Валидация титулов" IsChecked="{Binding TitleValidation}" Margin="0,0,0,8"
                                      ToolTip="Титул засчитывается только при поддержке другим маркером"/>
                            <CheckBox Content="Межфайловая дедупликация контекстов" IsChecked="{Binding CrossFileDedup}"
                                      ToolTip="Одинаковые контексты из разных файлов группируются: ×N вместо тридцати повторов"/>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,24,0,0">
                        <Expander.Header>
                            <TextBlock Text="REGEX-ИСКЛЮЧЕНИЯ" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Одна строка — один паттерн. Совпавший контекст отбрасывается."
                                       Style="{DynamicResource MetaStyle}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding UserExcludeText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="56" MaxHeight="120"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"/>
                            <!-- UX: inline-валидация — ошибка паттерна видна сразу под полем -->
                            <TextBlock Text="{Binding RegexValidationMessage, Mode=OneWay}"
                                       Style="{DynamicResource TechStyle}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushBranch4}"
                                       Visibility="{Binding RegexValidationMessage, Converter={StaticResource EmptyToCollapsed}}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,24,0,0">
                        <Expander.Header>
                            <TextBlock Text="ФОРМАТЫ ФАЙЛОВ" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Какие расширения включать в сканирование корпуса."
                                       Style="{DynamicResource MetaStyle}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding ExtensionFlags}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Extension}" IsChecked="{Binding Included}"
                                                  MinWidth="88" Margin="0,4,16,4"
                                                  ToolTip="{Binding Hint}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,24,0,0">
                        <Expander.Header>
                            <TextBlock Text="ВЫБОР СУЩНОСТЕЙ ДЛЯ АНАЛИЗА (Issue 3)" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <CheckBox Content="Включить селективный анализ (только выбранные сущности)"
                                      IsChecked="{Binding UseSelectiveAnalysis}"
                                      ToolTip="Если включено, анализ будет производиться только по отмеченным сущностям. Пусто = анализировать все."/>
                            <TextBox Text="{Binding EntitySearch, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,8,0,0"
                                     ToolTip="Поиск по имени, канону или алиасам"/>
                            <ListBox ItemsSource="{Binding AvailableEntities}"
                                     MinHeight="120" MaxHeight="240"
                                     Margin="0,8,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                          ToolTip="Включить сущность в селективный анализ"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Canonical}" Style="{DynamicResource TechStyle}"
                                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="28,2,0,0"/>
                                            <TextBlock Text="{Binding AliasCount, StringFormat='алиасов: {0}'}"
                                                       Style="{DynamicResource TechStyle}"
                                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="28,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding SelectedEntityIds.Count, StringFormat='Выбрано: {0}'}"
                                       Style="{DynamicResource MetaStyle}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource BrushBranch3}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,24,0,0">
                        <Expander.Header>
                            <TextBlock Text="ДОПОЛНИТЕЛЬНЫЕ ПАПКИ" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <ListBox ItemsSource="{Binding ExtraDirs}" SelectedItem="{Binding SelectedExtraDir}"
                                     MinHeight="40" MaxHeight="96">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{DynamicResource TechStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Добавить папку" Style="{DynamicResource GhostButtonStyle}"
                                        Command="{Binding AddExtraDir}"/>
                                <Button Content="Убрать" Style="{DynamicResource GhostButtonStyle}"
                                        Command="{Binding RemoveExtraDir}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,24,0,0">
                        <Expander.Header>
                            <TextBlock Text="КЭШ" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Повторные прогоны не перечитывают неизменённые файлы: результаты хранятся на диске (и в памяти в рамках сеанса). Устаревшие записи удаляются автоматически при открытии кэша."
                                       Style="{DynamicResource MetaStyle}" TextWrapping="Wrap"/>
                            <CheckBox Content="Кэш результатов на диске" IsChecked="{Binding CacheEnabled}"
                                      Margin="0,8,0,0"
                                      ToolTip="Выключение отключает и инкрементальный режим: каждый прогон читает корпус целиком"/>
                            <CheckBox Content="Кэш в памяти (L2) — повторные прогоны без диска"
                                      IsChecked="{Binding MemoryCacheEnabled}" Margin="0,8,0,0"
                                      ToolTip="Результаты живут в оперативной памяти сеанса: watch-режим и перезапуски анализа отвечают мгновенно, ничего не перечитывая"/>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Срок хранения, дней (0 = вечно)" Style="{DynamicResource MetaStyle}"/>
                                    <TextBox Text="{Binding CacheMaxAgeDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Лимит диска, МБ (0 = без лимита)" Style="{DynamicResource MetaStyle}"/>
                                    <TextBox Text="{Binding CacheMaxSizeMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Бюджет памяти L2, МБ (0 = выкл)" Style="{DynamicResource MetaStyle}" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding MemoryCacheBudgetMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CacheStatsText}" Style="{DynamicResource TechStyle}"
                                       TextWrapping="Wrap" Margin="0,16,0,0"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Обновить" Style="{DynamicResource GhostButtonStyle}"
                                        Command="{Binding RefreshCacheStatsCommand}" Padding="0,8"/>
                                <Button Content="Очистить кэш" Style="{DynamicResource GhostButtonStyle}"
                                        Command="{Binding ClearCacheCommand}" Padding="0,8" Margin="16,0,0,0"
                                        ToolTip="Удалить записи кэша с диска и из памяти (с подтверждением)"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Item 14: тема оформления и цвета подсветки сущностей -->
                    <Expander Margin="0,24,0,0">
                        <Expander.Header>
                            <TextBlock Text="ОФОРМЛЕНИЕ" Style="{DynamicResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Тема и цвета подсветки сущностей. Изменения применяются сразу, перезапуск не нужен."
                                       Style="{DynamicResource MetaStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="Тема" Style="{DynamicResource MetaStyle}" Margin="0,12,0,0"/>
                            <ComboBox ItemsSource="{Binding ThemeItems}"
                                      DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding ThemeKey, Mode=TwoWay}"
                                      Margin="0,8,0,0" MinWidth="260"
                                      ToolTip="Светлая «Академическая» — книжная светлая; тёмная «Северный ветер» — ночной режим"/>

                            <TextBlock Text="Цвета ветвей (подсветка сущностей; пусто — цвет темы)"
                                       Style="{DynamicResource MetaStyle}" Margin="0,16,0,0"/>
                            <UniformGrid Columns="1" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{DynamicResource BrushBranch1}"
                                            ToolTip="Действующий цвет ветви (превью)"/>
                                    <TextBlock Text="Божества / Древние" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding Branch1Color, UpdateSourceTrigger=LostFocus}"
                                             Width="120" Margin="12,0,0,0"
                                             ToolTip="Формат «#RRGGBB»; пусто — цвет из темы"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{DynamicResource BrushBranch2}"/>
                                    <TextBlock Text="Локации" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding Branch2Color, UpdateSourceTrigger=LostFocus}"
                                             Width="120" Margin="12,0,0,0"
                                             ToolTip="Формат «#RRGGBB»; пусто — цвет из темы"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{DynamicResource BrushBranch3}"/>
                                    <TextBlock Text="Артефакты" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding Branch3Color, UpdateSourceTrigger=LostFocus}"
                                             Width="120" Margin="12,0,0,0"
                                             ToolTip="Формат «#RRGGBB»; пусто — цвет из темы"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{DynamicResource BrushBranch4}"/>
                                    <TextBlock Text="Персоналии" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding Branch4Color, UpdateSourceTrigger=LostFocus}"
                                             Width="120" Margin="12,0,0,0"
                                             ToolTip="Формат «#RRGGBB»; пусто — цвет из темы"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{DynamicResource BrushBranch5}"/>
                                    <TextBlock Text="Книги / Культы" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding Branch5Color, UpdateSourceTrigger=LostFocus}"
                                             Width="120" Margin="12,0,0,0"
                                             ToolTip="Формат «#RRGGBB»; пусто — цвет из темы"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding ThemeMessage}" Style="{DynamicResource TechStyle}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <Button Content="Сбросить цвета ветвей" Style="{DynamicResource GhostButtonStyle}"
                                    Command="{Binding ResetBranchColorsCommand}" Padding="0,8" Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    ToolTip="Вернуть стандартную палитру активной темы"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ Правая колонка: вкладки «Обзор» / «Поиск и паттерны» (Bg-Main) ═══ -->
        <Grid Grid.Column="2" Margin="0,24,32,24">
            <!-- QA-UX #3: индекс вкладки управляется из MainViewModel (пункт рейки «Поиск и паттерны») -->
            <TabControl Background="Transparent" BorderThickness="0"
                        SelectedIndex="{Binding SearchTabIndex, Mode=TwoWay}">

                <!-- ── Вкладка ОБЗОР: статус корпуса, плитки, журнал ── -->
                <TabItem Header="ОБЗОР">
                    <Grid Margin="48,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

            <!-- Статус / статистика -->
            <Grid Grid.Row="0">
                <!-- Empty State + мини-онбординг: три шага первого сеанса -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="560" TextOptions.TextRenderingMode="ClearType"
                            Visibility="{Binding CorpusMissing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Корпус не загружен." Style="{DynamicResource H1Style}" TextAlignment="Center"/>
                    <TextBlock Text="Выберите текстовые файлы для начала работы."
                               Style="{DynamicResource BodyStyle}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="1 · Выберите папку с .txt в левой колонке"
                               Style="{DynamicResource BodyStyle}" TextAlignment="Center" Margin="0,32,0,0"/>
                    <TextBlock Text="2 · Нажмите «Запустить анализ»"
                               Style="{DynamicResource BodyStyle}" TextAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="3 · Цитаты появятся на странице «Результаты»"
                               Style="{DynamicResource BodyStyle}" TextAlignment="Center" Margin="0,8,0,0"/>
                    <Button Content="Что такое кодекс и кого ищут?"
                            Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding OpenCodexCommand}"
                            HorizontalAlignment="Center" Padding="0,12"
                            ToolTip="Кодекс — справочник сущностей: карточки с именами, алиасами и связями. Сейчас работает встроенный кодекс — его можно дополнить своими существами."/>
                    <!-- QA-UX #3: мостик к головной функции соупоминаемости и паттернов -->
                    <Button Content="Искать совместные упоминания и конструкции →"
                            Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding NavSearchTab}"
                            HorizontalAlignment="Center" Padding="0,12"
                            ToolTip="Гибкий поиск по двум объектам (в одном файле, рядом, разнесены) и семантические паттерны — конструкции вида «Год Красной Луны»"/>
                </StackPanel>

                <!-- Показатели последнего прогона: открытые блоки без карточек
                     (в скролле — собиратель отрывков меняет высоту правой колонки) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding CorpusMissing, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel VerticalAlignment="Top">
                    <UniformGrid Columns="6">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="ФАЙЛЫ С НАХОДКАМИ" Style="{DynamicResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding StatFiles}" Style="{DynamicResource StatNumberStyle}" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="УПОМИНАНИЙ" Style="{DynamicResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding StatMentions}" Style="{DynamicResource StatNumberStyle}" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="СУЩНОСТЕЙ" Style="{DynamicResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding StatEntities}" Style="{DynamicResource StatNumberStyle}" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="ВРЕМЯ" Style="{DynamicResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding StatDuration}" Style="{DynamicResource StatNumberStyle}" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <!-- QA-UX #12: плитка кликабельна — ведёт к отчётам о дублях -->
                            <Button HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                                    Padding="0" Command="{Binding OpenDuplicatesReport}"
                                    ToolTip="Файлы с идентичным содержимым (SHA-256). Нажмите — откроется отчёт duplicates.txt">
                                <TextBlock Text="ДУБЛИКАТЫ ТЕКСТОВ" Style="{DynamicResource SectionHeaderStyle}"/>
                            </Button>
                            <TextBlock Text="{Binding StatDuplicates}" Style="{DynamicResource StatNumberStyle}" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="24,0,0,0">
                            <TextBlock Text="СКРЫТО ЛИМИТОМ" Style="{DynamicResource SectionHeaderStyle}"
                                       ToolTip="Совпадения сверх лимита цитат на файл: они не отклонены фильтрами — просто не показаны. Лимит меняется на «Обзоре» (Цитат на файл) или профилем поиска."/>
                            <TextBlock Text="{Binding StatDisplayCapped}" Style="{DynamicResource StatNumberStyle}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- R3-1 (item 52): сборщик отрывков — тематические словари с морфологией,
                         отрывки из готового анализа, свои слова (user_themes.json), экспорт MD/CSV/JSON -->
                    <Expander Margin="0,32,0,0">
                        <Expander.Header>
                            <TextBlock Text="СБОРЩИК ОТРЫВКОВ · ТЕМАТИЧЕСКИЕ СЛОВАРИ"
                                       Style="{DynamicResource SectionHeaderStyle}"
                                       ToolTip="Отрывки по теме и сущности из готовой сессии анализа — корпус не пересканируется"/>
                        </Expander.Header>
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ТЕМА" Style="{DynamicResource SectionHeaderStyle}" VerticalAlignment="Center"
                                           ToolTip="Встроенные словари: география, архитектура, культ, битвы, пророчества; плюс ваши темы из user_themes.json"/>
                                <ComboBox ItemsSource="{Binding Excerpts.Themes}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding Excerpts.SelectedTheme}"
                                          MinWidth="200" Margin="8,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Тематический словарь: слова ищутся в контекстах с морфологией (падежи и формы)"/>
                                <TextBlock Text="СУЩНОСТЬ" Style="{DynamicResource SectionHeaderStyle}"
                                           VerticalAlignment="Center" Margin="24,0,0,0"/>
                                <ComboBox ItemsSource="{Binding Excerpts.Entities}"
                                          SelectedItem="{Binding Excerpts.SelectedEntity}"
                                          MinWidth="160" Margin="8,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Ограничить отрывки упоминаниями выбранной сущности"/>
                                <Button Content="Собрать отрывки" Style="{DynamicResource GhostButtonStyle}"
                                        Margin="24,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding Excerpts.CollectCommand}"
                                        ToolTip="Отрывки берутся из готового анализа (сессия, кэш) — корпус не сканируется заново"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Excerpts.Status}" Style="{DynamicResource MetaStyle}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>

                            <!-- Свои слова темы: добавляются к словарю и пишутся в user_themes.json -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox Text="{Binding Excerpts.NewWord, UpdateSourceTrigger=PropertyChanged}"
                                         Width="180" VerticalAlignment="Center"
                                         ToolTip="Своё слово для выбранной темы — сохраняется в user_themes.json и учитывается морфологией"/>
                                <Button Content="Добавить слово" Style="{DynamicResource GhostButtonStyle}"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding Excerpts.AddWordCommand}"/>
                                <TextBlock Text="{Binding Excerpts.WordsInfo}" Style="{DynamicResource MetaStyle}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Excerpts.UserWords}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{DynamicResource GhostButtonStyle}"
                                                FontSize="11" Margin="0,0,8,8"
                                                Command="{Binding DataContext.Excerpts.RemoveWordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Убрать своё слово из темы (user_themes.json)"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="ЭКСПОРТ" Style="{DynamicResource SectionHeaderStyle}" VerticalAlignment="Center"
                                           ToolTip="Отчёт по каждому отрывку с файлом и позицией; файлы открываются страницей «Отчёты»"/>
                                <Button Content="Markdown" Style="{DynamicResource GhostButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding Excerpts.ExportCommand}" CommandParameter="md"/>
                                <Button Content="CSV" Style="{DynamicResource GhostButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding Excerpts.ExportCommand}" CommandParameter="csv"/>
                                <Button Content="JSON" Style="{DynamicResource GhostButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding Excerpts.ExportCommand}" CommandParameter="json"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Excerpts.Items}" MaxHeight="240" Margin="0,12,0,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}" Style="{DynamicResource TechStyle}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PositionText}" Style="{DynamicResource MetaStyle}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding Entity}" Style="{DynamicResource TechStyle}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <Button Content="открыть" Style="{DynamicResource GhostButtonStyle}"
                                                        FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.Excerpts.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <!-- Слова темы в отрывке — точечная линия (R3-1) -->
                                            <TextBlock b:HighlightBehavior.Context="{Binding Context}"
                                                       b:HighlightBehavior.ThemeMarks="{Binding MarksText}"
                                                       b:HighlightBehavior.ThemeBrush="{DynamicResource BrushThemeMark}"
                                                       Style="{DynamicResource QuoteStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Журнал: технические строки, открытый блок -->
            <StackPanel Grid.Row="1" Margin="0,48,0,0">
                <TextBlock Text="ЖУРНАЛ" Style="{DynamicResource SectionHeaderStyle}"/>
                <ListBox ItemsSource="{Binding LogLines}" MinHeight="160" MaxHeight="256"
                         Margin="0,16,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{DynamicResource TechStyle}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ── Вкладка ПОИСК И ПАТТЕРНЫ: интегрированный модуль поиска ── -->
                <TabItem Header="ПОИСК И ПАТТЕРНЫ">
                    <views:AdvancedSearchPage
                        DataContext="{Binding DataContext.AdvancedSearch,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>

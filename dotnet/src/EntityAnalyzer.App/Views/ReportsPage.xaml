<UserControl x:Class="EntityAnalyzer.App.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Экран «Отчёты»: две вкладки — Просмотр (дерево файлов) и Выгрузка (форматы).
         UX: раньше это были два разных раздела с пересекающимися функциями —
         пользователь не понимал, где «правильное» место. -->
    <TabControl Background="Transparent" BorderThickness="0" Margin="32,24,32,24">
        <TabItem Header="ПРОСМОТР">
        <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="260"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <!-- Дерево отчётов -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="ОТЧЁТЫ" Style="{DynamicResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Обновить" Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="В папке" Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding OpenExternallyCommand}"
                            ToolTip="Показать файл в проводнике"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Граф связей" Style="{DynamicResource GhostButtonStyle}" Click="OpenGraph_Click"
                            ToolTip="Интерактивный граф ко-упоминаний (в браузере)"/>
                    <Button Content="Облако вариантов" Style="{DynamicResource GhostButtonStyle}" Click="OpenCloud_Click"
                            ToolTip="Частоты форм написания имён (в браузере)"/>
                </StackPanel>
                <!-- Item 42: Ctrl+F ищет поле с именем *SearchBox и ставит фокус сюда. -->
                <Grid Margin="0,16,0,0">
                    <TextBox x:Name="ReportSearchBox"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр дерева отчётов по имени файла или папки (Ctrl+F)"/>
                    <TextBlock Text="Фильтр отчётов…" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextDisabled}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <!-- Empty State -->
            <TextBlock Text="Отчётов пока нет. Запустите анализ — файлы появятся здесь."
                       Style="{DynamicResource MetaStyle}" TextWrapping="Wrap"
                       VerticalAlignment="Top" Margin="0,24,0,0"
                       Visibility="{Binding IsDataEmpty, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="По фильтру ничего не найдено — очистите поле «Фильтр отчётов»."
                       Style="{DynamicResource MetaStyle}" TextWrapping="Wrap"
                       VerticalAlignment="Top" Margin="0,24,0,0"
                       Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}"/>

            <TreeView ItemsSource="{Binding RootsView}" SelectedItemChanged="Tree_SelectedItemChanged"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource BrushTextSecondary}"
                      ItemContainerStyle="{x:Null}"
                      Visibility="{Binding IsDataEmpty, Converter={StaticResource InverseBoolToVis}}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      Style="{DynamicResource AcademicSplitterStyle}"/>

        <!-- Просмотрщик -->
        <Grid Grid.Column="2">
            <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                     IsReadOnly="True" IsEnabled="True"
                     Style="{DynamicResource BareTextBoxStyle}"
                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                     Foreground="{DynamicResource BrushTextPrimary}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Visibility="{Binding TextVisible, Converter={StaticResource BoolToVis}}"/>

            <WebBrowser x:Name="HtmlView"
                        Visibility="{Binding IsHtml, Converter={StaticResource BoolToVis}}"/>
            <!-- UX: надёжная альтернатива встроенному просмотру -->
            <Button Content="Открыть в браузере" Style="{DynamicResource GhostButtonStyle}"
                    Click="OpenInBrowser_Click"
                    Visibility="{Binding IsHtml, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,8"
                    ToolTip="Открыть текущий HTML-отчёт в системном браузере"/>
        </Grid>
        </Grid>
        </TabItem>
        <TabItem Header="ВЫГРУЗКА">
            <!-- Вкладка хостит существующую страницу экспорта (та же VM из окна) -->
            <ContentControl Content="{Binding DataContext.Export, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,24,0,0"/>
        </TabItem>
    </TabControl>
</UserControl>

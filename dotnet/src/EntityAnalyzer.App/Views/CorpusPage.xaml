<UserControl x:Class="EntityAnalyzer.App.Views.CorpusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Группа 3: «Корпус» — аналитика поверх текстов последнего прогона.
         Первая вкладка: поиск по фрагменту (item 31). -->
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding Fragment.SearchCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="32,32,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="КОРПУС" Style="{DynamicResource SectionHeaderStyle}"/>
            <TextBlock Style="{DynamicResource MetaStyle}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="Поиск по фрагменту идёт по всем файлам последнего прогона в три уровня: точная подстрока, падежные формы слов (морфология), варианты имён из каталога (синонимы) и приблизительное написание (fuzzy/парафраз). Результат — файл, строка и фрагмент с окрестностью. Вкладка «Темы» раскладывает файлы по тематическим словарям (география, архитектура, культ, битвы, пророчества и свои темы вроде «Космологии»)."/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
            <TabItem Header="ПОИСК ПО ФРАГМЕНТУ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Инструменты поиска -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBox Width="340" VerticalAlignment="Center"
                                 Text="{Binding Fragment.Query, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Фраза для поиска; Enter запускает поиск"/>
                        <Button Content="Искать" Style="{DynamicResource PrimaryButtonStyle}" Margin="12,0,0,0"
                                Command="{Binding Fragment.SearchCommand}"/>
                        <CheckBox Content="Морфология (падежные формы)" VerticalAlignment="Center" Margin="24,0,0,0"
                                  IsChecked="{Binding Fragment.UseMorphology}"
                                  ToolTip="Искать слова фразы в любой падежной форме"/>
                        <CheckBox Content="Fuzzy/парафраз" VerticalAlignment="Center" Margin="16,0,0,0"
                                  IsChecked="{Binding Fragment.UseFuzzy}"
                                  ToolTip="Допускать небольшие искажения написания слов"/>
                        <CheckBox Content="Синонимы (каталог)" VerticalAlignment="Center" Margin="16,0,0,0"
                                  IsChecked="{Binding Fragment.UseSynonyms}"
                                  ToolTip="Принимать варианты имён из каталога: поиск «Ктулху» найдёт и альтернативные написания той же сущности"/>
                    </StackPanel>

                    <!-- Статус -->
                    <TextBlock Grid.Row="1" Text="{Binding Fragment.Status}" Style="{DynamicResource MetaStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- Результаты -->
                    <ListBox Grid.Row="2" Margin="0,12,0,0"
                             ItemsSource="{Binding Fragment.Results}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding File}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LineText}"
                                               Style="{DynamicResource MetaStyle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding KindText}"
                                               Style="{DynamicResource MetaStyle}"
                                               Foreground="{DynamicResource BrushBranch1}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Fragment}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Fragment}"/>
                                    <Button Grid.Column="4" Content="Открыть"
                                            Style="{DynamicResource MiniGhostButtonStyle}"
                                            FontSize="11" Margin="12,0,0,0"
                                            Command="{Binding DataContext.Fragment.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Открыть файл в программе по умолчанию"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="ГОДЫ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Инструменты вкладки -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Content="Построить указатель" Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding Years.BuildCommand}"
                                ToolTip="Просканировать тексты всех файлов на четырёхзначные годы (1000–2199)"/>
                    </StackPanel>

                    <!-- Статус -->
                    <TextBlock Grid.Row="1" Text="{Binding Years.Status}" Style="{DynamicResource MetaStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- Шкала и файлы выбранного года -->
                    <Grid Grid.Row="2" Margin="0,12,0,0"
                          Visibility="{Binding Years.HasYears, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="180"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" Margin="0,0,24,0"
                                 ItemsSource="{Binding Years.Years}"
                                 SelectedItem="{Binding Years.SelectedYear}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding YearText}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding SummaryText}" Style="{DynamicResource MetaStyle}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Years.SelectedYear.YearText}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding Years.SelectedSummary}" Style="{DynamicResource MetaStyle}"
                                           Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Years.Files}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding File}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                                       Style="{DynamicResource MetaStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LineText}"
                                                       Style="{DynamicResource MetaStyle}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Snippet}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Snippet}"/>
                                            <Button Grid.Column="4" Content="Открыть"
                                                    Style="{DynamicResource MiniGhostButtonStyle}"
                                                    FontSize="11" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.Years.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Открыть файл в программе по умолчанию"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="ИНТЕРТЕКСТ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Инструменты вкладки -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Content="Найти связи" Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding Intertext.BuildCommand}"
                                ToolTip="Общие 4-граммы слов («дословно») и 3-граммы вне дословных совпадений («близко»)"/>
                    </StackPanel>

                    <!-- Статус -->
                    <TextBlock Grid.Row="1" Text="{Binding Intertext.Status}" Style="{DynamicResource MetaStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- Пары файлов и совпадения -->
                    <Grid Grid.Row="2" Margin="0,12,0,0"
                          Visibility="{Binding Intertext.HasPairs, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="240"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" Margin="0,0,24,0"
                                 ItemsSource="{Binding Intertext.Pairs}"
                                 SelectedItem="{Binding Intertext.SelectedPair}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ToolTipText}"/>
                                        <TextBlock Text="{Binding CountText}" Style="{DynamicResource MetaStyle}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Intertext.SelectedSummary}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Intertext.Matches}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Kind}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushBranch1}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LinesText}"
                                                       Style="{DynamicResource MetaStyle}"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding FragmentA}"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FragmentA}"/>
                                                <TextBlock Text="{Binding FragmentB}"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FragmentB}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="ТЕМЫ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Инструменты вкладки -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Content="Систематизировать" Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding Themes.BuildCommand}"
                                ToolTip="Каждый файл оценивается по тематическим словарям (морфология, свои темы из user_themes.json) и получает главную тему"/>
                        <TextBlock Text="Темы — наборы слов: встроенные словари и свои; свои слова добавляются на «Обзоре» в сборщике отрывков"
                                   Style="{DynamicResource MetaStyle}" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>

                    <!-- Статус -->
                    <TextBlock Grid.Row="1" Text="{Binding Themes.Status}" Style="{DynamicResource MetaStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- Темы и файлы -->
                    <Grid Grid.Row="2" Margin="0,12,0,0"
                          Visibility="{Binding Themes.HasGroups, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="240"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" Margin="0,0,24,0"
                                 ItemsSource="{Binding Themes.Groups}"
                                 SelectedItem="{Binding Themes.SelectedGroup}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Theme}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CountText}" Style="{DynamicResource MetaStyle}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Themes.SelectedSummary}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Themes.Files}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding File}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding ScoresText}"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ScoresText}"/>
                                                <TextBlock Text="{Binding WordsText}" Style="{DynamicResource MetaStyle}"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource BrushThemeMark}"
                                                           ToolTip="Слова-маркеры главной темы файла"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Открыть"
                                                    Style="{DynamicResource MiniGhostButtonStyle}"
                                                    FontSize="11" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.Themes.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Открыть файл в программе по умолчанию"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

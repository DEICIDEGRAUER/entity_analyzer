<UserControl x:Class="EntityAnalyzer.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Экран «История»: строгая таблица прогонов + детали.
         Статусы — только текст («Успешно»); числа по правому краю;
         выделение строки — линия 3px слева. -->
    <Grid Margin="32,32,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица прогонов -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" Orientation="Horizontal">
                <TextBlock Text="ИСТОРИЯ ПРОГОНОВ" Style="{DynamicResource SectionHeaderStyle}"
                           VerticalAlignment="Center"/>
                <Button Content="Обновить" Style="{DynamicResource GhostButtonStyle}" Margin="24,0,0,0"
                        Command="{Binding RefreshCommand}"/>
                <Button Content="Сравнить с последним" Style="{DynamicResource GhostButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding CompareCommand}"/>
                <Button Content="📦 Пакет воспроизводимости" Style="{DynamicResource GhostButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding ExportReproCommand}"
                        ToolTip=".earepro: прогон + журнал с хешами + конфигурация + SHA-256 корпуса — для рецензента"/>
                <Button Content="📄 Научное резюме" Style="{DynamicResource GhostButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding ExportAcademicCommand}"
                        ToolTip="Публикационное резюме (.md) поверх готового .earepro: аннотация, методология, результаты, целостность"/>
                <Button Content="🖨 Печать резюме" Style="{DynamicResource GhostButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding PrintAcademicCommand}"
                        ToolTip="Предпросмотр печати научного резюме из .earepro; PDF — принтером «Microsoft Print to PDF»"/>
            </StackPanel>

            <!-- Empty State -->
            <TextBlock Text="История пока пуста — выполните первый анализ."
                       Style="{DynamicResource BodyStyle}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsDataEmpty, Converter={StaticResource BoolToVis}}"/>

            <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" x:Name="RunsGrid"
                      Visibility="{Binding IsDataEmpty, Converter={StaticResource InverseBoolToVis}}">
                <DataGrid.Columns>
                    <!-- QA-UX #13: реальный статус прогона (не захардкожен) -->
                    <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushBranch4}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ДАТА" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="ПРЕСЕТ" Binding="{Binding Preset}" Width="90"/>
                    <DataGridTextColumn Header="УПОМИНАНИЙ" Binding="{Binding TotalMentions, StringFormat=N0}" Width="110"
                                        ElementStyle="{StaticResource NumericCellElementStyle}"/>
                    <DataGridTextColumn Header="ФАЙЛОВ" Binding="{Binding FilesWithMentions, StringFormat=N0}" Width="80"
                                        ElementStyle="{StaticResource NumericCellElementStyle}"/>
                    <DataGridTextColumn Header="RAW" Binding="{Binding RawMatches, StringFormat=N0}" Width="80"
                                        ElementStyle="{StaticResource NumericCellElementStyle}"/>
                    <DataGridTextColumn Header="СЕК" Binding="{Binding DurationSeconds, StringFormat=0.0}" Width="60"
                                        ElementStyle="{StaticResource NumericCellElementStyle}"/>
                    <!-- QA-UX #16: признак инкрементального прогона -->
                    <DataGridTextColumn Header="ИЗ КЭША" Binding="{Binding FilesFromCache, StringFormat=N0}" Width="80"
                                        ElementStyle="{StaticResource NumericCellElementStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BrushBorderLight}" Margin="24,0"/>

        <!-- Детали прогона -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="ДЕТАЛИ ПРОГОНА" Style="{DynamicResource SectionHeaderStyle}"
                       Margin="0,0,0,16"/>

            <!-- R1-9: дифф сущностей — две позиции прогона со стрелками-дельтами -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BrushBorderLight}"
                    BorderThickness="1,0,0,0" Padding="24,0,0,0" Margin="0,24,0,0"
                    Visibility="{Binding HasEntityDiffs, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding DiffHeader}" Style="{DynamicResource MetaStyle}" Margin="0,0,0,8"/>
                    <!-- Шапка -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="СУЩНОСТЬ" Style="{DynamicResource MetaStyle}"/>
                        <TextBlock Grid.Column="1" Text="БЫЛО" Style="{DynamicResource MetaStyle}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="СТАЛО" Style="{DynamicResource MetaStyle}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Δ" Style="{DynamicResource MetaStyle}" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding EntityDiffs}" MaxHeight="220"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Entity}"
                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Before}"
                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource BrushTextSecondary}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding After}"
                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource BrushTextPrimary}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeltaText}"
                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                               FontWeight="SemiBold" TextAlignment="Right"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Сравнение: открытый блок с линией слева, без заливки -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BrushBorderLight}"
                    BorderThickness="1,0,0,0" Padding="24,0,0,0" Margin="0,24,0,0"
                    Visibility="{Binding Comparison, Converter={StaticResource EmptyToCollapsed}}">
                <TextBox Text="{Binding Comparison, Mode=OneWay}" IsReadOnly="True"
                         Style="{DynamicResource BareTextBoxStyle}"
                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                         Foreground="{DynamicResource BrushTextSecondary}"
                         MaxHeight="160" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>

            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" x:Name="DetailsBox"
                     Style="{DynamicResource BareTextBoxStyle}"
                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="EntityAnalyzer.App.Views.SchemaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Экран «Схемы»: категории и типы связей. Строгие таблицы,
         выделение строк — только линия 3px + насыщеннее текст. -->
    <Grid Margin="32,32,32,24">
        <!-- QA-UX #7: подзаголовок-расшифровка — страница снова разговаривает с пользователем -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Схемы" Style="{DynamicResource H1Style}"/>
            <TextBlock Text="Категории карточек и типы связей между ними — структура вашего мира. Здесь задаётся каркас, по которому строятся графы и схемы отношений."
                       Style="{DynamicResource BodyStyle}" Foreground="{DynamicResource BrushTextSecondary}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

        <!-- Категории -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="КАТЕГОРИИ" Style="{DynamicResource SectionHeaderStyle}"
                       Margin="0,0,0,16"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <TextBox Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Имя новой категории" x:Name="NewTypeBox"/>
                <Button Content="Создать категорию" Style="{DynamicResource GhostButtonStyle}"
                        Command="{Binding AddType}" HorizontalAlignment="Left" Padding="0,8"/>
                <Button Content="Удалить категорию" Style="{DynamicResource GhostButtonStyle}"
                        Command="{Binding DeleteType}" HorizontalAlignment="Left" Padding="0,8"
                        ToolTip="Удалять можно только пустые категории"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                     DisplayMemberPath="Name" x:Name="TypesList"/>
        </DockPanel>

        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BrushBorderLight}" Margin="24,0"/>

        <!-- Поля выбранной категории + связи -->
        <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Поля категории">
                <DockPanel Margin="0,24,8,24" IsEnabled="{Binding HasSelection}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{DynamicResource MetaStyle}">
                            <Run Text="Карточек в категории: "/><Run Text="{Binding TypeCardCount, Mode=OneWay}"/>
                        </TextBlock>
                        <UniformGrid Columns="3" Margin="0,16,0,0">
                            <TextBox Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,16,0" ToolTip="Название поля"/>
                            <ComboBox ItemsSource="{Binding AllFieldTypes}" SelectedItem="{Binding NewFieldType}"
                                      Margin="0,0,16,0"/>
                            <Button Content="Добавить поле" Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding AddField}"/>
                        </UniformGrid>
                    </StackPanel>

                    <ListView ItemsSource="{Binding SelectedType.Fields}" x:Name="FieldsList" Margin="0,24,0,0">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="ПОЛЕ" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="ТИП" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Type}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="↑" Style="{DynamicResource MiniGhostButtonStyle}" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.MoveFieldUp,
                                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="↓" Style="{DynamicResource MiniGhostButtonStyle}" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.MoveFieldDown,
                                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="✕" Style="{DynamicResource MiniGhostButtonStyle}"
                                                            Command="{Binding DataContext.DeleteField,
                                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Типы связей">
                <DockPanel Margin="0,24,8,24">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBox Text="{Binding NewRelationLabel, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Подпись связи, например «владеет» (обратная совпадёт)"/>
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Button Content="Создать тип связи" Style="{DynamicResource GhostButtonStyle}"
                                    Command="{Binding AddRelation}" Margin="0,0,16,0"/>
                            <Button Content="Удалить выбранный" Style="{DynamicResource GhostButtonStyle}"
                                    Command="{Binding DeleteRelation}"/>
                        </UniformGrid>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Relations}" SelectedItem="{Binding SelectedRelation}"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ПРЯМАЯ" Binding="{Binding ForwardLabel}" Width="*"/>
                            <DataGridTextColumn Header="ОБРАТНАЯ" Binding="{Binding ReverseLabel}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</UserControl>

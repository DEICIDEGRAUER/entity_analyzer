<Window x:Class="EntityAnalyzer.App.Views.CodexPackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека кодексов" Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgMain}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Встроенные тематические паки карточек. Импорт добавит новые карточки в ваш кодекс; существующие имена не дублируются."
                   Style="{DynamicResource MetaStyle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <ListBox Grid.Row="1" x:Name="PackList" SelectionChanged="PackList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource SerifFontFamily}" FontSize="15"/>
                        <TextBlock Text="{Binding Description}" Style="{DynamicResource MetaStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Импортировать" Style="{DynamicResource PrimaryButtonStyle}"
                    x:Name="ImportButton" Click="Import_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Left" Content="Закрыть" Style="{DynamicResource GhostButtonStyle}"
                    Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>

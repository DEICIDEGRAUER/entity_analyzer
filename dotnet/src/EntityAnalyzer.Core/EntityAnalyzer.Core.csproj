<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EntityAnalyzer.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Entity mention analysis engine for text corpora (Aho-Corasick, variant generation, filtering, reporting).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EntityAnalyzer.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\default_catalog.json" />
    <EmbeddedResource Include="Resources\default_codex.json" />
    <EmbeddedResource Include="Resources\default_semantic_patterns.json" />
    <EmbeddedResource Include="Resources\default_semantic_lexicons.json" />
    <EmbeddedResource Include="Resources\selfcheck_baseline.json" />
    <EmbeddedResource Include="Resources\codex_pack_*.json" />
  </ItemGroup>

</Project>

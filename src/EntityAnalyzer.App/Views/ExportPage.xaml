<UserControl x:Class="EntityAnalyzer.App.Views.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Экран «Экспорт»: форматы + воронка фильтров.
         Воронка — две тонкие линии (сырые / итоговые), легенда — точки 6×6. -->
    <Grid Margin="32,32,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <!-- Экспорт -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="ЭКСПОРТ ОТЧЁТОВ" Style="{DynamicResource SectionHeaderStyle}"/>

            <!-- QA-UX #9: мостик «анализ уже записал файлы» — снимает конфликт моделей -->
            <TextBlock Text="{Binding LastAutoExportInfo}" Style="{DynamicResource MetaStyle}"
                       TextWrapping="Wrap" Margin="0,16,0,0"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Visibility="{Binding HasLastAutoExport, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Formats}" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsEnabled}" Margin="0,0,0,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Item 50: статьи о сущностях идут поверх выбранных форматов -->
            <TextBlock Style="{DynamicResource MetaStyle}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Text="Плюс к форматам: энциклопедические статьи о сущностях (articles/ — Markdown и индекс), папки by_entity с упоминаниями и статьёй, варианты написаний и граф упоминаний."/>

            <!-- Плюс: протокол проверки, когда есть вердикты -->
            <TextBlock Text="{Binding ReviewReportInfo}" Style="{DynamicResource MetaStyle}"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource BrushTextSecondary}"/>

            <TextBlock Text="Папка вывода" Style="{DynamicResource MetaStyle}" Margin="0,24,0,0"/>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Выбрать…" Style="{DynamicResource GhostButtonStyle}"
                        Command="{Binding BrowseOutput}" Margin="16,0,0,0"/>
                <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                <Button Content="Экспортировать" Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding ExportCommand}"/>
                <Button Content="Открыть папку" Style="{DynamicResource GhostButtonStyle}" Margin="16,0,0,0"
                        Command="{Binding OpenFolder}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BrushBorderLight}" Margin="24,0"/>

        <!-- Воронка качества -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <TextBlock Text="ВОРОНКА ФИЛЬТРОВ" Style="{DynamicResource SectionHeaderStyle}"/>

            <TextBlock Text="{Binding FunnelText}" Style="{DynamicResource TechStyle}"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>

            <!-- Сырые совпадения -->
            <ProgressBar Value="{Binding BarRaw, Mode=OneWay}" Maximum="100" Margin="0,24,0,0"
                         Foreground="{DynamicResource BrushTextDisabled}"/>
            <!-- Итоговые цитаты -->
            <ProgressBar Value="{Binding BarFinal, Mode=OneWay}" Maximum="100" Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource BrushTextDisabled}"/>
                <TextBlock Text="сырые совпадения" Style="{DynamicResource MetaStyle}" Margin="8,0,0,0"/>
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="24,0,0,0"
                         Fill="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="итоговые цитаты" Style="{DynamicResource MetaStyle}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
